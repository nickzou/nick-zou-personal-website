{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        { "slug": "base", "name": "Base", "color": "#ffffff" },
        { "slug": "contrast", "name": "Contrast", "color": "#111111" },
        { "slug": "accent", "name": "Accent", "color": "#2563eb" },
        {
          "slug": "accent-secondary",
          "name": "Accent Secondary",
          "color": "#db2777"
        },
        {
          "slug": "accent-tertiary",
          "name": "Accent Tertiary",
          "color": "#06b6d4"
        }
      ]
    },
    "typography": {
      "fontSizes": [{ "slug": "small", "name": "Small", "size": "0.875rem" }],
      "fontFamilies": [
        {
          "slug": "noto-sans",
          "name": "Noto Sans",
          "fontFamily": "'Noto Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Noto Sans",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/noto-sans-latin-wght-normal.woff2"]
            },
            {
              "fontFamily": "Noto Sans",
              "fontStyle": "italic",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/noto-sans-latin-wght-italic.woff2"]
            }
          ]
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--noto-sans)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": { "left": "1.5rem", "right": "1.5rem" }
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" }
      }
    }
  }
}
